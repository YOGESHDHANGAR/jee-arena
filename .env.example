# ---- JEE Arena (this app) ----
# The platform's OWN database. Keep it separate from JEE Studio's database.
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=jee_arena

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Comma-separated emails that get admin rights when they register
ADMIN_EMAILS=you@example.com

PORT=4000
# Only needed if the web app is served from a different origin in production
CORS_ORIGIN=http://localhost:5173

# Public address of the site in production, e.g. https://jeearena.in (used for the sitemap,
# canonical links and share cards). Leave empty to work it out from each request.
SITE_URL=

# ---- Question pictures on a CDN (optional, for later) ----
# media/ is served by this server by default. To move it to Cloudflare R2:
#   1. Create an R2 bucket, turn on its public URL (or connect a custom domain like media.yoursite.in)
#   2. Create an R2 API token with Object Read & Write, fill in the four R2_ values below
#   3. npm run media:upload        (safe to re-run; only uploads new files — run it after each import)
#   4. Set MEDIA_BASE_URL to the bucket's public URL and restart. Old /media links redirect there.
MEDIA_BASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---- Import source (read-only) ----
# JEE Video Studio folder. The importer opens <STUDIO_PATH>/bank/jee-bank.db read-only
# and copies needed diagrams from <STUDIO_PATH>/public/images into jee-arena/media.
STUDIO_PATH=../jee-video-studio

# ---- Google AdSense (optional) ----
# Your publisher ID from AdSense (Account > Settings > Account information), e.g. ca-pub-1234567890123456
ADSENSE_CLIENT=
# Ad unit IDs (AdSense > Ads > By ad unit > Display ads). Leave any empty to skip that spot.
# RAIL: a fixed-size 160x600 display unit, shown on the left and right of the page on wide screens.
ADSENSE_SLOT_RAIL=
# BOTTOM: a responsive display unit, shown once at the bottom of the page on phones / small screens.
ADSENSE_SLOT_BOTTOM=
# 1 = show grey placeholder boxes where ads go (to check layout before approval)
ADS_PREVIEW=0
